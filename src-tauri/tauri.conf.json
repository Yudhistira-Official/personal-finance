{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Finance",
  "version": "0.2.1",
  "identifier": "com.personalfinance.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Personal Finance",
        "width": 420,
        "height": 820,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwMDA2MkVFNzRFQzU1NTkKUldSWlZleDA3bUlBVUdYVFdLVHI4Rjg5eldybGpLMlFkclRnekpRWnNsNlFURmhLZndZWmRjTlAK",
      "endpoints": [
        "https://github.com/Yudhistira-Official/personal-finance/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
